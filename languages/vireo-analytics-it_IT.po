#, php-format
msgid "Importing %1$s — %2$s"
msgstr "Importazione di %1$s — %2$s"

#: importers/class-jetpack-importer.php:202
msgid "Missing import parameters. Please submit the form again."
msgstr "Parametri di importazione mancanti. Invia di nuovo il modulo."

#: importers/class-jetpack-importer.php:214
msgid "Invalid date range — please use YYYY-MM-DD."
msgstr "Intervallo di date non valido — usa il formato AAAA-MM-GG."

#: importers/class-jetpack-importer.php:218
msgid "End date must be on or after start date."
msgstr "La data di fine deve essere uguale o successiva alla data di inizio."

#: importers/class-jetpack-importer.php:242
msgid "Complete"
msgstr "Completato"

#. translators: %s: HTTP error detail returned by WP_Error.
#: importers/class-jetpack-importer.php:404
#, php-format
msgid "Could not reach Jetpack Stats API: %s"
msgstr "Impossibile raggiungere l'API di Jetpack Stats: %s"

#: importers/class-jetpack-importer.php:423
msgid "Unexpected (non-JSON) response from Jetpack Stats API."
msgstr "Risposta imprevista (non JSON) dall'API di Jetpack Stats."

#: importers/class-jetpack-importer.php:439
msgid ""
"Invalid or unauthorized API key. Copy your WordPress.com API key from "
"Jetpack → Settings → Security → Akismet."
msgstr ""
"Chiave API non valida o non autorizzata. Copia la tua chiave API di "
"WordPress.com da Jetpack → Impostazioni → Sicurezza → Akismet."

#: importers/class-jetpack-importer.php:443
msgid ""
"Jetpack Stats API is rate-limiting — please wait a minute and try again."
msgstr ""
"L'API di Jetpack Stats sta limitando le richieste — attendi un minuto e "
