msgstr ""
"Lo zip contiene più file di quelli presenti in un'esportazione di Plausible."

#: importers/class-plausible-importer.php:540
msgid "A file inside the zip could not be read."
msgstr "Impossibile leggere un file all'interno dello zip."

#. translators: 1: Plausible report name, 2: column name
#: importers/class-plausible-importer.php:616
#, php-format
msgid "The %1$s file is missing its %2$s column."
msgstr "Nel file %1$s manca la colonna %2$s."

#: importers/class-plausible-importer.php:640
#: importers/class-plausible-importer.php:686
msgid ""
"That export is too large to import in one go. Choose a shorter date range "
"and import it in parts."
msgstr ""
"L'esportazione è troppo grande per essere importata in un'unica volta. "
"Scegli un intervallo di date più breve e importala a più riprese."

