#. Description of the plugin
#: vireo-analytics.php
msgid ""
"Privacy-first WordPress analytics. Clean dashboard, no cookies, no consent "
"banners, no third-party tracking."
msgstr ""
"Analisi web per WordPress che mette la privacy al primo posto. Dashboard "
"essenziale, senza cookie, senza banner di consenso, senza tracciamento di "
"terze parti."

