msgstr ""
"Wir haben %s auf dieser Website gefunden. Importieren Sie diesen Verlauf, "
"damit Ihre Zahlen nicht bei null beginnen. Ihre vorhandenen Daten werden nur"
" gelesen und nie verändert."

#: templates/admin/import-onboarding.php:72
msgid "Start fresh"
msgstr "Neu beginnen"

#. translators: 1: first day Vireo Analytics recorded, 2: the day before it
#: templates/admin/import-own-data.php:26
#, php-format
