#: importers/class-koko-importer.php:147
#, php-format
msgid "Importing %1$s — %2$s"
msgstr "%1$s — %2$s importeren"

#: importers/class-jetpack-importer.php:202
msgid "Missing import parameters. Please submit the form again."
msgstr "Ontbrekende importparameters. Verstuur het formulier opnieuw."

#: importers/class-jetpack-importer.php:214
msgid "Invalid date range — please use YYYY-MM-DD."
msgstr "Ongeldig datumbereik, gebruik JJJJ-MM-DD."

#: importers/class-jetpack-importer.php:218
msgid "End date must be on or after start date."
msgstr "De einddatum moet op of na de startdatum liggen."

#: importers/class-jetpack-importer.php:242
msgid "Complete"
msgstr "Voltooid"

#. translators: %s: HTTP error detail returned by WP_Error.
#: importers/class-jetpack-importer.php:404
#, php-format
msgid "Could not reach Jetpack Stats API: %s"
msgstr "Kan de Jetpack Stats-API niet bereiken: %s"

#: importers/class-jetpack-importer.php:423
msgid "Unexpected (non-JSON) response from Jetpack Stats API."
msgstr "Onverwacht (niet-JSON) antwoord van de Jetpack Stats-API."

#: importers/class-jetpack-importer.php:439
msgid ""
"Invalid or unauthorized API key. Copy your WordPress.com API key from "
"Jetpack → Settings → Security → Akismet."
msgstr ""
"Ongeldige of niet-geautoriseerde API-sleutel. Kopieer je WordPress.com-API-"
"sleutel via Jetpack → Instellingen → Beveiliging → Akismet."

#: importers/class-jetpack-importer.php:443
msgid ""
"Jetpack Stats API is rate-limiting — please wait a minute and try again."
msgstr ""
"De Jetpack Stats-API beperkt het aantal verzoeken. Wacht een minuut en "
"probeer het opnieuw."

#: importers/class-jetpack-importer.php:447
msgid ""
"Jetpack Stats API is unavailable right now. Please retry in a few minutes."
msgstr ""
"De Jetpack Stats-API is momenteel niet beschikbaar. Probeer het over een "
"paar minuten opnieuw."

#. translators: %d: HTTP status code returned by the Jetpack API.
#: importers/class-jetpack-importer.php:454
#, php-format
msgid ""
"Jetpack Stats API returned an error (HTTP %d). Check your API key and blog "
