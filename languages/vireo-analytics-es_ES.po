msgstr "Faltan parámetros de importación. Vuelve a enviar el formulario."

#: importers/class-jetpack-importer.php:214
msgid "Invalid date range — please use YYYY-MM-DD."
msgstr "Rango de fechas no válido: usa el formato AAAA-MM-DD."

#: importers/class-jetpack-importer.php:218
msgid "End date must be on or after start date."
msgstr "La fecha de fin debe ser igual o posterior a la de inicio."

#: importers/class-jetpack-importer.php:242
msgid "Complete"
msgstr "Completado"

#. translators: %s: HTTP error detail returned by WP_Error.
#: importers/class-jetpack-importer.php:404
