msgstr "Неизвестная возможность."

#: includes/class-abilities.php:1212
msgid "Start date (YYYY-MM-DD). Defaults to 30 days ago."
msgstr "Дата начала (ГГГГ-ММ-ДД). По умолчанию 30 дней назад."

#: includes/class-abilities.php:1217
msgid "End date (YYYY-MM-DD). Defaults to today."
msgstr "Дата окончания (ГГГГ-ММ-ДД). По умолчанию сегодня."

#: includes/class-abilities.php:1232
msgid "Maximum number of rows to return (1-100)."
msgstr "Максимальное число возвращаемых строк (1–100)."

