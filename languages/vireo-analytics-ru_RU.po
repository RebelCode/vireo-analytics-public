msgstr "Импорт Independent Analytics завершён."

#. translators: 1: days imported, 2: total days.
#: importers/class-independent-analytics-importer.php:168
#, php-format
msgid "Imported %1$d of %2$d day from Independent Analytics."
msgid_plural "Imported %1$d of %2$d days from Independent Analytics."
msgstr[0] "Импортирован %1$d из %2$d дня из Independent Analytics."
msgstr[1] "Импортировано %1$d из %2$d дней из Independent Analytics."
msgstr[2] "Импортировано %1$d из %2$d дней из Independent Analytics."

#: importers/class-independent-analytics-importer.php:173
msgid ""
"Brings across daily pageviews and visitors, your pages, referrers, which "
"posts each referrer sent readers to, countries, browsers, operating systems,"
" devices, missing pages, and tracked link clicks and form submissions as "
