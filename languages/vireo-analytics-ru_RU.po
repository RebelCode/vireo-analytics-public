#: importers/class-burst-importer.php:26
msgid "Burst Statistics"
msgstr "Burst Statistics"

#: importers/class-burst-importer.php:73
msgid "No Burst Statistics data found."
msgstr "Данные Burst Statistics не найдены."

#: importers/class-burst-importer.php:99
msgid "Burst Statistics import complete."
msgstr "Импорт Burst Statistics завершён."

#. translators: 1: days imported, 2: total days.
#: importers/class-burst-importer.php:177
#, php-format
msgid "Imported %1$d of %2$d day from Burst Statistics."
msgid_plural "Imported %1$d of %2$d days from Burst Statistics."
msgstr[0] "Импортирован %1$d из %2$d дня из Burst Statistics."
msgstr[1] "Импортировано %1$d из %2$d дней из Burst Statistics."
msgstr[2] "Импортировано %1$d из %2$d дней из Burst Statistics."

#: importers/class-burst-importer.php:182
msgid ""
"Brings across daily pageviews and visitors, your pages, referrers, which "
"posts each referrer sent readers to, countries, browsers, operating systems,"
" devices and missing pages."
msgstr ""
"Переносит ежедневные просмотры и посетителей, ваши страницы, источники "
"переходов, записи, на которые каждый источник привёл читателей, страны, "
"браузеры, операционные системы, устройства и несуществующие страницы."

#: importers/class-ga4-importer.php:42
msgid "Google Analytics 4"
msgstr "Google Analytics 4"

#: importers/class-ga4-importer.php:140
msgid "Add the service account key and the GA4 property ID first."
msgstr "Сначала добавьте ключ сервисного аккаунта и ID ресурса GA4."

#: importers/class-ga4-importer.php:145
msgid "The date range is not valid."
msgstr "Указан недопустимый диапазон дат."

#. translators: 1: start date, 2: end date
#: importers/class-ga4-importer.php:186
#: importers/class-plausible-importer.php:359
#, php-format
msgid "Imported %1$s to %2$s"
msgstr "Импортировано с %1$s по %2$s"

#: importers/class-ga4-importer.php:435
msgid ""
"Google refused the request. Check the service account has Viewer access on "
"this GA4 property."
msgstr ""
"Google отклонил запрос. Проверьте, что у сервисного аккаунта есть доступ на "
"просмотр (Viewer) к этому ресурсу GA4."

#. translators: %d: HTTP status code
#: importers/class-ga4-importer.php:442
#, php-format
msgid "Google Analytics returned an unexpected response (HTTP %d)."
msgstr "Google Analytics вернул неожиданный ответ (HTTP %d)."

#: importers/class-ga4-importer.php:449
msgid "Google Analytics returned a response we could not read."
msgstr "Google Analytics вернул ответ, который не удалось прочитать."

#: importers/class-ga4-importer.php:564
#: importers/class-plausible-importer.php:899
